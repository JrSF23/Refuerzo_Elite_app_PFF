# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno para Docker Compose — Refuerzo Elite V2
#
# Cómo usar:
#   cp .env.docker.example .env.docker
#   # Edita .env.docker con tus valores reales
#   docker compose --env-file .env.docker up
#
# NUNCA subas .env.docker a git (está en .gitignore).
# Este fichero de ejemplo SÍ se puede commitear (sin valores reales).
# ─────────────────────────────────────────────────────────────────────────────

# ── Laravel ──────────────────────────────────────────────────────────────────
# Genera una clave con: php artisan key:generate --show
APP_KEY=base64:t4YImlBAjmsaE5Bc936A1eHXA/9+hIyFUPUzJCs+IJE=

# URL pública del servidor (sin barra final)
APP_URL=http://localhost

# Español es el idioma por defecto del producto (Principio XII de la constitución).
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# ── Base de datos ─────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_password_seguro
MYSQL_DATABASE=refuerzo_elite_v2
MYSQL_USER=refuerzo
MYSQL_PASSWORD=password_seguro

# ── Seeder ────────────────────────────────────────────────────────────────────
# Contraseña del usuario admin creado por AdminSeeder
ADMIN_PASSWORD=Admin12345!

# Contraseña del super administrador de plataforma. Cámbiela antes de desplegar.
SUPER_ADMIN_PASSWORD=SuperAdmin12345!
