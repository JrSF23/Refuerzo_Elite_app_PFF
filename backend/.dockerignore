# Dependencias — se instalan dentro del contenedor con composer install
vendor/

# Entorno local — el contenedor recibe las vars por docker-compose
.env
.env.*
!.env.example

# Logs y caché generados en tiempo de ejecución
storage/logs/*.log
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
bootstrap/cache/*.php

# Artefactos de testing y herramientas de desarrollo
.phpunit.result.cache
.php-cs-fixer.cache
tests/

# Git y editores
.git/
.gitignore
*.md
